#!/usr/bin/env python3

import json
import socket
import sys

SOCKET = "/run/hks401d.sock"

QUERIES = (
    "ports",
    "focus",
    "mapping",
    "buzzer",
    "lighting",
    "mixed_focus",
    "usb_compat",
    "network",
    "mouse",
    "fan",
    "audio_follow",
    "audio",
    "autoscan",
)

def usage():
    print(
        f"Usage: {sys.argv[0]} "
        "{1|2|3|4|state|query <name>}",
        file=sys.stderr,
    )
    print(
        "Query names: " + ", ".join(QUERIES),
        file=sys.stderr,
    )


if len(sys.argv) == 2:
    arg = sys.argv[1]

    if arg in ("1", "2", "3", "4"):
        command = f"select {arg}\n"
        mode = "select"

    elif arg == "state":
        command = "state\n"
        mode = "state"

    else:
        usage()
        sys.exit(2)

elif len(sys.argv) == 3 and sys.argv[1] == "query":
    name = sys.argv[2]

    if name not in QUERIES:
        print(f"Unknown query: {name}", file=sys.stderr)
        usage()
        sys.exit(2)

    command = f"query {name}\n"
    mode = "query"

else:
    usage()
    sys.exit(2)


try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(SOCKET)
        s.sendall(command.encode())
        data = s.recv(4096)

    result = json.loads(data)

    if not result.get("ok"):
        print(
            result.get("error", "HKS401 command failed"),
            file=sys.stderr,
        )
        sys.exit(1)

    if mode == "state":
        print(json.dumps(result["state"], indent=2))

    elif mode == "query":
        print(json.dumps(result, indent=2))

except Exception as ex:
    print(f"HKS401 daemon error: {ex}", file=sys.stderr)
    sys.exit(1)
