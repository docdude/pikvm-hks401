#!/bin/bash
set -euo pipefail

SOURCE="/usr/local/lib/hks401/hks401.py"

if [[ ! -f "$SOURCE" ]]; then
    echo "ERROR: HKS401 source not found: $SOURCE" >&2
    exit 1
fi

PLUGIN_DIR="$(
    python - <<'PY'
import os
import kvmd.plugins.ugpio
print(os.path.dirname(os.path.realpath(kvmd.plugins.ugpio.__file__)))
PY
)"

TARGET="${PLUGIN_DIR}/hks401.py"

echo "KVMD UGPIO directory: $PLUGIN_DIR"
echo "HKS401 source:         $SOURCE"
echo "Plugin target:         $TARGET"

#
# Already installed correctly.
#
if [[ -L "$TARGET" ]]; then
    CURRENT="$(readlink -f "$TARGET")"

    if [[ "$CURRENT" == "$SOURCE" ]]; then
        echo "HKS401 symlink already correct."
    else
        echo "Replacing stale HKS401 symlink:"
        echo "  old -> $CURRENT"
        rm "$TARGET"
        ln -s "$SOURCE" "$TARGET"
        echo "  new -> $SOURCE"
    fi

#
# Never overwrite a real file.
#
elif [[ -e "$TARGET" ]]; then
    echo "ERROR: $TARGET exists and is not a symlink." >&2
    echo "Refusing to overwrite it." >&2
    exit 1

else
    ln -s "$SOURCE" "$TARGET"
    echo "Created HKS401 plugin symlink."
fi

#
# Verify that the currently installed KVMD can load it.
#
python - <<'PY'
from kvmd.plugins import get_plugin_class

cls = get_plugin_class("ugpio", "hks401")

print("HKS401 plugin import OK")
print("Class:", cls)
print("Module:", cls.__module__)
PY

echo
echo "HKS401 KVMD plugin installation OK."
