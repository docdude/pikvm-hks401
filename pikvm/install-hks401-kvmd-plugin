#!/bin/bash
set -euo pipefail

PY_SOURCE="/usr/local/lib/hks401/hks401.py"
CSS_SOURCE="/usr/local/lib/hks401/hks401.css"

WEB_ROOT="/usr/share/kvmd/web"
CSS_DIR="${WEB_ROOT}/share/css"
CSS_TARGET="${CSS_DIR}/hks401.css"
KVM_INDEX="${WEB_ROOT}/kvm/index.html"

#
# Verify persistent HKS401 sources.
#
if [[ ! -f "$PY_SOURCE" ]]; then
    echo "ERROR: HKS401 source not found: $PY_SOURCE" >&2
    exit 1
fi

if [[ ! -f "$CSS_SOURCE" ]]; then
    echo "ERROR: HKS401 CSS source not found: $CSS_SOURCE" >&2
    exit 1
fi

#
# Locate the UGPIO plugin directory for the currently installed KVMD.
#
PLUGIN_DIR="$(
    python - <<'PY'
import os
import kvmd.plugins.ugpio
print(os.path.dirname(os.path.realpath(kvmd.plugins.ugpio.__file__)))
PY
)"

PLUGIN_TARGET="${PLUGIN_DIR}/hks401.py"

echo "KVMD UGPIO directory: $PLUGIN_DIR"
echo "HKS401 source:         $PY_SOURCE"
echo "Plugin target:         $PLUGIN_TARGET"

#
# Install/recover the HKS401 UGPIO plugin symlink.
#
if [[ -L "$PLUGIN_TARGET" ]]; then
    CURRENT="$(readlink -f "$PLUGIN_TARGET")"

    if [[ "$CURRENT" == "$PY_SOURCE" ]]; then
        echo "HKS401 symlink already correct."
    else
        echo "Replacing stale HKS401 symlink:"
        echo "  old -> $CURRENT"
        rm "$PLUGIN_TARGET"
        ln -s "$PY_SOURCE" "$PLUGIN_TARGET"
        echo "  new -> $PY_SOURCE"
    fi

#
# Never overwrite a real plugin file.
#
elif [[ -e "$PLUGIN_TARGET" ]]; then
    echo "ERROR: $PLUGIN_TARGET exists and is not a symlink." >&2
    echo "Refusing to overwrite it." >&2
    exit 1

else
    ln -s "$PY_SOURCE" "$PLUGIN_TARGET"
    echo "Created HKS401 plugin symlink."
fi

#
# Verify that the currently installed KVMD can load the plugin.
#
python - <<'PY'
from kvmd.plugins import get_plugin_class

cls = get_plugin_class("ugpio", "hks401")

print("HKS401 plugin import OK")
print("Class:", cls)
print("Module:", cls.__module__)
PY

#
# Install/recover HKS401 web stylesheet.
#
if [[ ! -d "$CSS_DIR" ]]; then
    echo "ERROR: PiKVM CSS directory not found: $CSS_DIR" >&2
    exit 1
fi

if [[ ! -f "$KVM_INDEX" ]]; then
    echo "ERROR: PiKVM KVM index not found: $KVM_INDEX" >&2
    exit 1
fi

install -m 0644 "$CSS_SOURCE" "$CSS_TARGET"
echo "Installed HKS401 stylesheet: $CSS_TARGET"

#
# Ensure the KVM page loads our stylesheet.
#
CSS_LINK='<link rel="stylesheet" href="../share/css/hks401.css">'

if grep -Fq "$CSS_LINK" "$KVM_INDEX"; then
    echo "HKS401 stylesheet link already present."
else
    if ! grep -Fq 'href="../share/css/switch.css"' "$KVM_INDEX"; then
        echo "ERROR: Could not locate switch.css link in $KVM_INDEX" >&2
        echo "Refusing to modify an unknown PiKVM web layout." >&2
        exit 1
    fi

    sed -i \
        '/href="\.\.\/share\/css\/switch\.css"/a\    <link rel="stylesheet" href="../share/css/hks401.css">' \
        "$KVM_INDEX"

    echo "Inserted HKS401 stylesheet link."
fi

#
# Final verification.
#
cmp -s "$CSS_SOURCE" "$CSS_TARGET" || {
    echo "ERROR: Installed HKS401 stylesheet does not match source." >&2
    exit 1
}

grep -Fq "$CSS_LINK" "$KVM_INDEX" || {
    echo "ERROR: HKS401 stylesheet link verification failed." >&2
    exit 1
}

echo
echo "HKS401 KVMD plugin and web UI installation OK."
