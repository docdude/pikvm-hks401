#!/bin/bash
# Runs as kvmd ExecStartPre. Writes only when something is missing or stale,
# and never edits PiKVM-owned web files.
set -euo pipefail

PY_SOURCE="/usr/local/lib/hks401/hks401.py"
CSS_SOURCE="/usr/local/lib/hks401/hks401.css"

# Official user stylesheet hook: nginx serves it as share/css/user.css.
USER_CSS="/etc/kvmd/web.css"
CSS_BEGIN="/* BEGIN hks401 (managed by install-hks401-kvmd-plugin) */"
CSS_END="/* END hks401 */"

# Earlier revisions patched these PiKVM files; undo if still present.
LEGACY_CSS="/usr/share/kvmd/web/share/css/hks401.css"
KVM_INDEX="/usr/share/kvmd/web/kvm/index.html"
LEGACY_LINK='<link rel="stylesheet" href="../share/css/hks401.css">'

#
# PiKVM boots with a read-only root; remount only if a write is needed.
#
REMOUNTED=0

ensure_rw() {
    if [[ $REMOUNTED -eq 0 ]] && findmnt -no OPTIONS / | tr ',' '\n' | grep -qx ro; then
        mount -o remount,rw /
        REMOUNTED=1
    fi
}

restore_ro() {
    if [[ $REMOUNTED -eq 1 ]]; then
        sync
        mount -o remount,ro / || echo "WARNING: could not remount / read-only" >&2
    fi
}

trap restore_ro EXIT

#
# Verify persistent HKS401 sources.
#
if [[ ! -f "$PY_SOURCE" ]]; then
    echo "ERROR: HKS401 source not found: $PY_SOURCE" >&2
    exit 1
fi

if [[ ! -f "$CSS_SOURCE" ]]; then
    echo "ERROR: HKS401 CSS source not found: $CSS_SOURCE" >&2
    exit 1
fi

#
# Locate the UGPIO plugin directory for the currently installed KVMD.
#
PLUGIN_DIR="$(
    python3 - <<'PY'
import os
import kvmd.plugins.ugpio
print(os.path.dirname(os.path.realpath(kvmd.plugins.ugpio.__file__)))
PY
)"

PLUGIN_TARGET="${PLUGIN_DIR}/hks401.py"

echo "KVMD UGPIO directory: $PLUGIN_DIR"
echo "HKS401 source:         $PY_SOURCE"
echo "Plugin target:         $PLUGIN_TARGET"

#
# Install/recover the HKS401 UGPIO plugin symlink.
#
if [[ -L "$PLUGIN_TARGET" ]]; then
    CURRENT="$(readlink -f "$PLUGIN_TARGET")"

    if [[ "$CURRENT" == "$PY_SOURCE" ]]; then
        echo "HKS401 symlink already correct."
    else
        echo "Replacing stale HKS401 symlink:"
        echo "  old -> $CURRENT"
        ensure_rw
        ln -sfn "$PY_SOURCE" "$PLUGIN_TARGET"
        echo "  new -> $PY_SOURCE"
    fi

#
# Never overwrite a real plugin file.
#
elif [[ -e "$PLUGIN_TARGET" ]]; then
    echo "ERROR: $PLUGIN_TARGET exists and is not a symlink." >&2
    echo "Refusing to overwrite it." >&2
    exit 1

else
    ensure_rw
    ln -s "$PY_SOURCE" "$PLUGIN_TARGET"
    echo "Created HKS401 plugin symlink."
fi

#
# Verify that the currently installed KVMD can load the plugin.
#
python3 - <<'PY'
from kvmd.plugins import get_plugin_class

cls = get_plugin_class("ugpio", "hks401")

print("HKS401 plugin import OK")
print("Class:", cls)
print("Module:", cls.__module__)
PY

#
# Install/refresh the HKS401 block in the user stylesheet, preserving any
# other user CSS.
#
CURRENT_CSS="$(cat "$USER_CSS" 2>/dev/null || true)"
OTHER_CSS="$(
    printf '%s\n' "$CURRENT_CSS" \
        | sed '\|^/\* BEGIN hks401 |,\|^/\* END hks401 \*/$|d'
)"
WANTED_CSS="$(
    [[ -n "$OTHER_CSS" ]] && printf '%s\n\n' "$OTHER_CSS"
    printf '%s\n' "$CSS_BEGIN"
    cat "$CSS_SOURCE"
    printf '%s\n' "$CSS_END"
)"

if [[ "$CURRENT_CSS" == "$WANTED_CSS" ]]; then
    echo "HKS401 stylesheet block already current."
else
    ensure_rw
    printf '%s\n' "$WANTED_CSS" > "${USER_CSS}.tmp"
    chmod 0644 "${USER_CSS}.tmp"
    mv "${USER_CSS}.tmp" "$USER_CSS"
    echo "Updated HKS401 stylesheet block in $USER_CSS"
fi

#
# Remove legacy modifications of PiKVM web files.
#
if [[ -f "$KVM_INDEX" ]] && grep -Fq "$LEGACY_LINK" "$KVM_INDEX"; then
    ensure_rw
    sed -i '\|href="\.\./share/css/hks401\.css"|d' "$KVM_INDEX"
    echo "Removed legacy HKS401 link from $KVM_INDEX"
fi

if [[ -e "$LEGACY_CSS" ]]; then
    ensure_rw
    rm -f "$LEGACY_CSS"
    echo "Removed legacy $LEGACY_CSS"
fi

echo
echo "HKS401 KVMD plugin and web UI installation OK."
